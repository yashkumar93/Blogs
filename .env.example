# --- Database (Neon Postgres) ---
# Get a connection string from https://console.neon.tech
# Use the pooled connection string for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full"

# --- Public site ---
# Absolute origin of the deployed site. Used for canonical URLs,
# sitemap entries, Open Graph, and RSS links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (Phase 1) ---
# Random 32+ byte secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Single-admin credentials (seed script will hash this on first run).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- AI (Phase 5) ---
# Groq API key for meta-description and title suggestions.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# --- Image upload (Cloudinary, unsigned preset) ---
# Both are NEXT_PUBLIC because Cloudinary unsigned uploads happen in the
# browser. Security comes from the upload preset itself:
#   1. https://console.cloudinary.com → Settings → Upload presets → Add
#   2. Signing Mode: Unsigned
#   3. Folder: blog-covers   (locks all uploads to one folder)
#   4. Allowed formats: jpg, png, webp, avif
#   5. Max file size: 5000000  (5 MB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
